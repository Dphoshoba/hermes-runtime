# R1 Remote M8 — environment configuration.
#
# COPY this to .env and fill in real values. NEVER commit .ev
# The orchestration reads these via docker-compose.

# A LONG, RANDOM, SECRET string used to sign participant JWTs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EVOSIA_JWT_SECRET=

# The EXACT public origin the participant will use in their browser, e.g.
# https://m8.evosia.example  (no trailing slash, MUST be HTTPS).
EVOSIA_CORS_ALLOW_ORIGINS=https://localhost

# Deployment mode: production | development
# production -> JWT fail-closed is active (recommended for real participants).
EVOSIA_ENV=production

# Port the participant connects to (host port mapped to nginx 443).
M8_HTTPS_PORT=443

# Fixture gate: enabled allows seed/reset/verify via the fixture CLI.
EVOSIA_M8_FIXTURE=enabled

# Optional: Gemini API key. Leave blank to prove the Gemini-independent run.
# EVOSIA_GEMINI_API_KEY=
